# Settings for local development. In the cluster the same
# settings come from ConfigMap open-nutrilog-config and Secret open-nutrilog-secrets
# (x-real-ip/gitops, manifests/open-nutrilog/).

# --- Server ---
PORT=8080
LOG_LEVEL=info
# Public base URL (needed for OIDC redirects).
APP_URL=http://localhost:8080

# --- Database ---
DATABASE_URL=postgres://open_nutrilog:change-me@localhost:5432/open_nutrilog
# Run pending migrations at startup. In the cluster an init container runs
# `npm run migrate` first and this is set to false.
MIGRATE_ON_START=true

# What "a day" is (diary days, day totals). The profile can override it.
TZ=Europe/Amsterdam

# --- Open Food Facts (barcode lookups; the server calls it, never the browser) ---
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_MS=8000
# A cached product is fetched again after this many days.
OFF_REFRESH_DAYS=30

# --- Authentication: none | password | proxy | oidc ---
AUTH_MODE=none
# Recommended in every mode except none; generated and stored in the database when empty.
SESSION_SECRET=
SESSION_DAYS=30

# password mode
APP_PASSWORD=

# oidc mode (Authentik OAuth2/OpenID provider)
OIDC_ISSUER_URL=https://auth.lan.stamx.nl/application/o/open-nutrilog/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Authentik
# Trust an internal CA for the OIDC issuer (the cluster mounts the Stamx CA here).
# NODE_EXTRA_CA_CERTS=/etc/ssl/stamx/ca.crt

# proxy mode (Authentik proxy outpost / forward auth); these are the defaults
PROXY_USER_HEADER=x-authentik-username
PROXY_EMAIL_HEADER=x-authentik-email
PROXY_GROUPS_HEADER=x-authentik-groups
PROXY_LOGOUT_URL=/outpost.goauthentik.io/sign_out

# Optional allowlists for oidc and proxy mode (comma separated).
# ALLOWED_USERS matches the username or the e-mail address.
ALLOWED_USERS=
ALLOWED_GROUPS=
