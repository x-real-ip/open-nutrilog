{
  "name": "open-nutrilog",
  "private": true,
  "description": "Personal, self-hosted calorie and nutrition tracker that links with Open Strength",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "migrate": "node --disable-warning=ExperimentalWarning server/migrate.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'server/tests/*.test.ts'",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "build": "npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "import:nevo": "node --disable-warning=ExperimentalWarning server/scripts/importNevo.ts",
    "import:off": "node --disable-warning=ExperimentalWarning server/scripts/importOff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "openid-client": "^6.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^19.0.0-beta.20",
    "oidc-provider": "^9.15.1",
    "typescript": "^7.0.2"
  }
}
